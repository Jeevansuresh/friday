# Discord
DISCORD_TOKEN=
# The single channel this bot listens in
DISCORD_CHANNEL_ID=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fitness_bot

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name for the classifier LLM
AZURE_OPENAI_DEPLOYMENT_CLASSIFIER=
# Deployment name for the estimator/SQL/composer LLM
AZURE_OPENAI_DEPLOYMENT_MAIN=

# Scheduler
TIMEZONE=Asia/Kolkata
# 3 daily checks, comma-separated, 24h format IST
NOTIFICATION_HOURS=9,14,21
